# .env.example — copy to .env.local and fill in for local dev.
# Vite only exposes VITE_-prefixed vars to client code (import.meta.env).

VITE_GOOGLE_CLIENT_ID=

# Google Tag Manager (web container) — see index.html's consent-gated
# loader and src/ConsentBanner.jsx. Server-side CAPI delivery (Meta
# Conversions API) is configured entirely inside the GTM server-side
# container, not via any frontend env var.
VITE_GTM_CONTAINER_ID=
