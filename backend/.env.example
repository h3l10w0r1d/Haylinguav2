# backend/.env.example — copy to backend/.env and fill in for local dev.

# GTM server-side container forwarder (backend/integrations/gtm_server.py).
# Points at OUR deployed server-side GTM container, not at Meta directly —
# that container holds the Meta Conversions API tag + access token, which
# never lives in this backend's own env. Safe to leave unset/disabled: the
# forwarder no-ops (see gtm_server.py's _enabled()/_url() gates).
GTM_SERVER_ENABLED=false
GTM_SERVER_URL=

# Web Push (backend/webpush.py) — VAPID keypair identifying this server to
# browser push services. Generate a fresh pair with:
#   python3 -c "
#   import base64
#   from cryptography.hazmat.primitives.asymmetric import ec
#   pk = ec.generate_private_key(ec.SECP256R1())
#   pub = pk.public_key().public_numbers()
#   b64 = lambda b: base64.urlsafe_b64encode(b).rstrip(b'=').decode()
#   print('VAPID_PUBLIC_KEY=' + b64(b'\x04' + pub.x.to_bytes(32,'big') + pub.y.to_bytes(32,'big')))
#   print('VAPID_PRIVATE_KEY=' + b64(pk.private_numbers().private_value.to_bytes(32,'big')))
#   "
# Until both are set, GET /webpush/vapid-public-key 503s and the frontend
# never attempts to subscribe — safe to leave unset.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@haylingua.am
