{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "haylingua.am" }],
      "destination": "https://www.haylingua.am/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://haylinguav2.onrender.com/sitemap.xml" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
